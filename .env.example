## Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=your-redirect-uri-here

## (Optional) API Keys for Additional Services
# NASA API Key (for astronomy picture of the day, etc.)
# NASA_API_KEY=your-nasa-api-key-here

# Geocoding API Key (for location features)
# GEOCODING_API_KEY=your-geocoding-api-key-here

## (Optional) Azure Credentials
# Azure Storage Account Name
# AZURE_STORAGE_ACCOUNT=your-azure-storage-account-name

# Azure Storage Account Key
# AZURE_STORAGE_KEY=your-azure-storage-account-key

# Azure Blob Container Name
# AZURE_BLOB_CONTAINER=your-blob-container-name

# Azure Connection String (alternative to above)
# AZURE_CONNECTION_STRING=your-azure-connection-string

# Add any other environment variables below as needed
