<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="830"
             x:Class="AstroGathering.Pages.HelpPage">
    
    <!-- Help Page with Cosmic Theme -->
    <Grid Background="#1a1235">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>  <!-- Sidebar Navigation -->
            <ColumnDefinition Width="*"/>    <!-- Main Content -->
        </Grid.ColumnDefinitions>
        
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" 
                Background="#2d1b69" 
                CornerRadius="0,20,20,0"
                Margin="0,0,20,0">
            <StackPanel Margin="30,40">
                
                <!-- Header -->
                <StackPanel Orientation="Horizontal" 
                           Margin="0,0,0,30">
                    <TextBlock Text="Help Center" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Navigation Buttons -->
                <StackPanel Spacing="15">
                    
                    <Button x:Name="HelpSupportBtn"
                            Background="#4c3a8a" 
                            Foreground="White" 
                            CornerRadius="10" 
                            Height="50"
                            Width="240"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Help &amp; Support" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="DataSourcesBtn"
                            Background="#3d2d5a" 
                            Foreground="White" 
                            CornerRadius="10" 
                            Height="50"
                            Width="240"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Data Sources" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="ContactSupportBtn"
                            Background="#3d2d5a" 
                            Foreground="White" 
                            CornerRadius="10" 
                            Height="50"
                            Width="240"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Contact &amp; Support" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="AboutBtn"
                            Background="#3d2d5a" 
                            Foreground="White" 
                            CornerRadius="10" 
                            Height="50"
                            Width="240"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="About" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="PrivacyBtn"
                            Background="#3d2d5a" 
                            Foreground="White" 
                            CornerRadius="10" 
                            Height="50"
                            Width="240"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Terms &amp; Privacy" 
                                      FontSize="14" 
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" 
                     Margin="20,40,40,40"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto">
            
            <!-- Content will be dynamically loaded here -->
            <StackPanel x:Name="MainContent">
                
                <!-- Default: Help & Support Section -->
                <StackPanel x:Name="HelpSupportContent" IsVisible="True">
                    <TextBlock Text="Help &amp; Support" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Step by step instructions to help you get the most out of AstroGathering" 
                              FontSize="16" 
                              Foreground="#B0B0B0" 
                              Margin="0,0,0,30"/>
                    
                    <!-- Dynamic content will be loaded here from database -->
                    
                </StackPanel>
                
                <!-- Data Sources Section -->
                <StackPanel x:Name="DataSourcesContent" IsVisible="False">
                    <TextBlock Text="Data Sources &amp; Services" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Learn about the APIs and services that power AstroGathering" 
                              FontSize="16" 
                              Foreground="#B0B0B0" 
                              Margin="0,0,0,30"/>
                    
                    <!-- Dynamic content will be loaded here from database -->
                    
                </StackPanel>
                
                <!-- Contact & Support Section -->
                <StackPanel x:Name="ContactSupportContent" IsVisible="False">
                    <TextBlock Text="Contact &amp; Support" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Send us a message - we're here to help!" 
                              FontSize="16" 
                              Foreground="#B0B0B0" 
                              Margin="0,0,0,30"/>
                    
                    <!-- Dynamic content will be loaded here from database -->
                    
                </StackPanel>
                
                <!-- About Section -->
                <StackPanel x:Name="AboutContent" IsVisible="False">
                    <TextBlock Text="About AstroGathering" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Learn about our mission and the features that make AstroGathering special" 
                              FontSize="16" 
                              Foreground="#B0B0B0" 
                              Margin="0,0,0,30"/>
                    
                    <!-- Dynamic content will be loaded here from database -->
                    
                </StackPanel>
                
                <!-- Privacy & Terms Section -->
                <StackPanel x:Name="PrivacyContent" IsVisible="False">
                    <TextBlock Text="Terms &amp; Privacy" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="How we handle your data and protect your privacy" 
                              FontSize="16" 
                              Foreground="#B0B0B0" 
                              Margin="0,0,0,30"/>
                    
                    <!-- Dynamic content will be loaded here from database -->
                    
                </StackPanel>
                
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>
