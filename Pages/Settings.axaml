<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="830"
             x:Class="AstroGathering.Pages.SettingsPage">
    
    <!-- Enhanced Settings Page with Profile and Admin sections -->
    <Grid Background="#1a1235">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>  <!-- Profile Section -->
            <ColumnDefinition Width="*"/>    <!-- Stats and Admin Section -->
        </Grid.ColumnDefinitions>
        
        <!-- Left Column: Profile Section -->
        <ScrollViewer Grid.Column="0" Margin="40,40,20,40">
            <StackPanel Spacing="25">
                
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Profile Settings" 
                              FontSize="24" 
                              FontWeight="Bold" 
                              Foreground="White" 
                              VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- User Profile Section -->
                <Border Background="#2d1b69" 
                        CornerRadius="15" 
                        Padding="25">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Profile Information" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="White"/>
                        
                        <!-- Profile Picture and Basic Info -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Profile Picture -->
                            <Border Grid.Column="0" 
                                    Width="70" 
                                    Height="70" 
                                    CornerRadius="35" 
                                    Background="#4c3a8a"
                                    ClipToBounds="True">
                                <TextBlock x:Name="ProfileInitials"
                                          Text="ID" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Basic Info -->
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" Spacing="5">
                                <TextBlock x:Name="UserNameText" 
                                          Text="Welcome!" 
                                          FontSize="16" 
                                          FontWeight="Bold"
                                          Foreground="White"/>
                                <TextBlock x:Name="UserEmailText" 
                                          Text="" 
                                          FontSize="12" 
                                          Foreground="#b8a7d9"/>
                                <TextBlock x:Name="AdminBadge" 
                                          Text="Administrator" 
                                          FontSize="11" 
                                          Foreground="#FFD700"
                                          IsVisible="False"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Detailed Info Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Google ID:" Foreground="#b8a7d9" FontWeight="Medium"/>
                            <TextBlock x:Name="UserIdText" Grid.Row="0" Grid.Column="1" Text="" Foreground="White" FontSize="12"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Joined:" Foreground="#b8a7d9" FontWeight="Medium" Margin="0,10,0,0"/>
                            <TextBlock x:Name="CreatedAtText" Grid.Row="1" Grid.Column="1" Text="" Foreground="White" FontSize="12" Margin="0,10,0,0"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Login:" Foreground="#b8a7d9" FontWeight="Medium" Margin="0,10,0,0"/>
                            <TextBlock x:Name="LastLoginText" Grid.Row="2" Grid.Column="1" Text="" Foreground="White" FontSize="12" Margin="0,10,0,0"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Status:" Foreground="#b8a7d9" FontWeight="Medium" Margin="0,10,0,0"/>
                            <TextBlock x:Name="UserStatusText" Grid.Row="3" Grid.Column="1" Text="Active Member" Foreground="#90EE90" FontSize="12" Margin="0,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Actions Section -->
                <Border Background="#2d1b69" 
                        CornerRadius="15" 
                        Padding="25">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Account Actions" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White"/>
                        
                        <Button Background="#6b4c8a" 
                               Foreground="White" 
                               CornerRadius="8" 
                               Height="35" 
                               Width="140"
                               HorizontalAlignment="Left">
                            <TextBlock Text="Update Profile"/>
                        </Button>
                        
                        <Button x:Name="LogoutButton" 
                               Background="#d32f2f" 
                               Foreground="White" 
                               CornerRadius="8" 
                               Height="35" 
                               Width="100"
                               HorizontalAlignment="Left">
                            <TextBlock Text="Sign Out"/>
                        </Button>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Right Column: Stats and Admin Section -->
        <ScrollViewer Grid.Column="1" Margin="20,40,40,40">
            <StackPanel Spacing="25">
                
                <!-- User Statistics -->
                <Border Background="#2d1b69" 
                        CornerRadius="15" 
                        Padding="25">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Your Statistics" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="White"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Photos Uploaded -->
                            <Border Grid.Column="0" 
                                    Background="#1a1235" 
                                    CornerRadius="10" 
                                    Padding="20"
                                    Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="5">
                                    <TextBlock Text="Photos" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PhotosUploadedText" 
                                              Text="24" 
                                              FontSize="28" 
                                              FontWeight="Bold"
                                              Foreground="White" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Photos Uploaded" 
                                              FontSize="12" 
                                              Foreground="#b8a7d9" 
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Likes Received -->
                            <Border Grid.Column="1" 
                                    Background="#1a1235" 
                                    CornerRadius="10" 
                                    Padding="20"
                                    Margin="10,0,0,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="5">
                                    <TextBlock Text="Likes" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LikesReceivedText" 
                                              Text="456" 
                                              FontSize="28" 
                                              FontWeight="Bold"
                                              Foreground="White" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Likes Received" 
                                              FontSize="12" 
                                              Foreground="#b8a7d9" 
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Admin Panel (Only visible to admins) -->
                <Border x:Name="AdminPanel" 
                        Background="#2d1b69" 
                        CornerRadius="15" 
                        Padding="25"
                        IsVisible="False">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Admin Panel" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="White"/>
                        <TextBlock Text="Manage users, content, and community moderation" 
                                  FontSize="12" 
                                  Foreground="#b8a7d9"/>
                        
                        <!-- Admin Stats Cards -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Total Users -->
                            <Border Grid.Column="0" 
                                    Background="#1a1235" 
                                    CornerRadius="12" 
                                    Padding="20"
                                    Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="TotalUsersText" 
                                              Text="3" 
                                              FontSize="24" 
                                              FontWeight="Bold"
                                              Foreground="White" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Users" 
                                              FontSize="12" 
                                              Foreground="#b8a7d9" 
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Total Photos -->
                            <Border Grid.Column="1" 
                                    Background="#1a1235" 
                                    CornerRadius="12" 
                                    Padding="20"
                                    Margin="5,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="TotalPhotosText" 
                                              Text="3" 
                                              FontSize="24" 
                                              FontWeight="Bold"
                                              Foreground="White" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Photos" 
                                              FontSize="12" 
                                              Foreground="#b8a7d9" 
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Pending Review -->
                            <Border Grid.Column="2" 
                                    Background="#1a1235" 
                                    CornerRadius="12" 
                                    Padding="20"
                                    Margin="10,0,0,0">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock x:Name="PendingReportsText" 
                                              Text="2" 
                                              FontSize="24" 
                                              FontWeight="Bold"
                                              Foreground="#FFA500" 
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Pending Review" 
                                              FontSize="12" 
                                              Foreground="#b8a7d9" 
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Admin Data Tables -->
                        <StackPanel Spacing="20">
                            
                            <!-- Recent Users Section -->
                            <Border Background="#1a1235" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Recent Users" 
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Foreground="White"/>
                                    <ScrollViewer x:Name="UsersScrollViewer" Height="200">
                                        <StackPanel x:Name="UsersPanel" Spacing="8"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            
                            <!-- Recent Photos Section -->
                            <Border Background="#1a1235" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Recent Photos" 
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Foreground="White"/>
                                    <ScrollViewer x:Name="PhotosScrollViewer" Height="200">
                                        <StackPanel x:Name="PhotosPanel" Spacing="8"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            
                            <!-- Reports Section -->
                            <Border Background="#1a1235" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Reports &amp; Moderation" 
                                              FontSize="16" 
                                              FontWeight="Bold" 
                                              Foreground="White"/>
                                    <ScrollViewer x:Name="ReportsScrollViewer" Height="150">
                                        <StackPanel x:Name="ReportsPanel" Spacing="8"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            
                        </StackPanel>
                        
                    </StackPanel>
                </Border>
                
                <!-- App Settings (Available to all users) -->
                <Border Background="#2d1b69" 
                        CornerRadius="15" 
                        Padding="25">
                    <StackPanel Spacing="15">
                        <TextBlock Text="App Preferences" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White"/>
                        
                        <CheckBox Content="Enable notifications for astronomical events" 
                                 Foreground="#b8a7d9" 
                                 IsChecked="True"/>
                        <CheckBox Content="Auto-sync calendar events" 
                                 Foreground="#b8a7d9" 
                                 IsChecked="True"/>
                        <CheckBox Content="Show community photos in gallery" 
                                 Foreground="#b8a7d9" 
                                 IsChecked="True"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>
