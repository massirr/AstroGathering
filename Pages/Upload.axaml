<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AstroGathering.Pages.UploadPage"
             Background="#1a1a2e">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="Upload Your Astronomical Photo" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Share your observations with the community" 
                       FontSize="16" 
                       Foreground="#9ca3af" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Main Content Grid -->
        <Grid Grid.Row="2" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="400"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="1*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Left Column - Photo Upload -->
            <Border Grid.Column="0" Grid.Row="0"
                    Background="#16213e" 
                    CornerRadius="12" 
                    Padding="25"
                    BorderBrush="#374151" 
                    BorderThickness="1"
                    VerticalAlignment="Stretch">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Photo Upload Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock Text="Photo Upload" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- File Selection Area -->
                    <Border Grid.Row="2"
                            Background="#0f1729" 
                            CornerRadius="10" 
                            Padding="40" 
                            BorderBrush="#374151" 
                            BorderThickness="2"
                            MinHeight="200">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Name="ChoosePhotoButton"
                                    Content="Choose Photo"
                                    Background="#3b82f6"
                                    Foreground="White"
                                    Padding="20,12"
                                    CornerRadius="8"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Click="ChoosePhoto_Click"
                                    HorizontalAlignment="Center"/>
                            
                            <TextBlock Text="or drag and drop your photo here"
                                       Foreground="#9ca3af"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,15,0,0"/>
                            
                            <TextBlock Name="SelectedFileText"
                                       Text="No file selected"
                                       Foreground="#60a5fa"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Photo Details Form -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20">
                            <StackPanel>
                                <TextBlock Text="Photo Name" 
                                           Foreground="White" 
                                           FontWeight="SemiBold" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <TextBox Name="NameBox"
                                         Background="#0f1729"
                                         Foreground="White"
                                         BorderBrush="#374151"
                                         CornerRadius="6"
                                         Padding="12"
                                         FontSize="14"
                                         Watermark="Enter a name for your photo"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Description" 
                                           Foreground="White" 
                                           FontWeight="SemiBold" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <TextBox Name="DescriptionBox"
                                         Background="#0f1729"
                                         Foreground="White"
                                         BorderBrush="#374151"
                                         CornerRadius="6"
                                         Padding="12"
                                         FontSize="14"
                                         AcceptsReturn="True"
                                         Height="100"
                                         TextWrapping="Wrap"
                                         Watermark="Describe what you observed..."/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Tags" 
                                           Foreground="White" 
                                           FontWeight="SemiBold" 
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <TextBox Name="TagsBox"
                                         Background="#0f1729"
                                         Foreground="White"
                                         BorderBrush="#374151"
                                         CornerRadius="6"
                                         Padding="12"
                                         FontSize="14"
                                         Watermark="astronomy, nebula, deep-space"/>
                                <TextBlock Text="Separate tags with commas" 
                                           Foreground="#6b7280" 
                                           FontSize="12" 
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column - Observation Details -->
            <Border Grid.Column="2" Grid.Row="0"
                    Background="#16213e" 
                    CornerRadius="12" 
                    Padding="25"
                    BorderBrush="#374151" 
                    BorderThickness="1"
                    VerticalAlignment="Stretch">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Observation Details Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock Text="Observation Details" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Details Form -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="25">
                            <!-- Location Section -->
                            <StackPanel>
                                <TextBlock Text="Location" 
                                           Foreground="White" 
                                           FontWeight="SemiBold" 
                                           FontSize="16"
                                           Margin="0,0,0,18"/>
                                
                                <StackPanel Spacing="20">
                                    <!-- Location Search -->
                                    <StackPanel>
                                        <TextBlock Text="Search Location" 
                                                   Foreground="#9ca3af" 
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBox Name="LocationSearchBox"
                                                     Grid.Column="0"
                                                     Background="#0f1729"
                                                     Foreground="White"
                                                     BorderBrush="#374151"
                                                     BorderThickness="1"
                                                     CornerRadius="8"
                                                     Padding="16,12"
                                                     FontSize="15"
                                                     Height="50"
                                                     Watermark="Enter city, address or place name..."
                                                     KeyDown="LocationSearchBox_KeyDown"/>
                                            
                                            <Button Name="SearchLocationButton"
                                                    Grid.Column="2"
                                                    Content="Search"
                                                    Background="#3b82f6"
                                                    Foreground="White"
                                                    CornerRadius="8"
                                                    Padding="16,12"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Height="50"
                                                    Click="SearchLocation_Click"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Coordinates Display -->
                                    <StackPanel>
                                        <TextBlock Text="Coordinates" 
                                                   Foreground="#9ca3af" 
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Column="0" Grid.Row="0"
                                                       Text="Latitude" 
                                                       Foreground="#6b7280" 
                                                       FontSize="12"/>
                                            <TextBox Name="LatitudeBox"
                                                     Grid.Column="0" Grid.Row="2"
                                                     Background="#0f1729"
                                                     Foreground="White"
                                                     BorderBrush="#374151"
                                                     BorderThickness="1"
                                                     CornerRadius="6"
                                                     Padding="12"
                                                     FontSize="14"
                                                     IsReadOnly="True"
                                                     Watermark="Latitude will appear here"/>

                                            <TextBlock Grid.Column="2" Grid.Row="0"
                                                       Text="Longitude" 
                                                       Foreground="#6b7280" 
                                                       FontSize="12"/>
                                            <TextBox Name="LongitudeBox"
                                                     Grid.Column="2" Grid.Row="2"
                                                     Background="#0f1729"
                                                     Foreground="White"
                                                     BorderBrush="#374151"
                                                     BorderThickness="1"
                                                     CornerRadius="6"
                                                     Padding="12"
                                                     FontSize="14"
                                                     IsReadOnly="True"
                                                     Watermark="Longitude will appear here"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Quick Location Button -->
                                    <Button Name="UseCurrentLocationButton"
                                            Content="Use Demo Location (Antwerp)"
                                            Background="#374151"
                                            Foreground="White"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            HorizontalAlignment="Stretch"
                                            Click="UseCurrentLocation_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Date and Time Section -->
                            <StackPanel>
                                <TextBlock Text="Date &amp; Time" 
                                           Foreground="White" 
                                           FontWeight="SemiBold" 
                                           FontSize="16"
                                           Margin="0,0,0,18"/>
                                
                                <StackPanel Spacing="20">
                                    <!-- Date Section -->
                                    <StackPanel>
                                        <TextBlock Text="Date" 
                                                   Foreground="#9ca3af" 
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,10"/>
                                        <DatePicker Name="DatePicker"
                                                    Background="#0f1729"
                                                    Foreground="White"
                                                    BorderBrush="#374151"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16,12"
                                                    FontSize="15"
                                                    Height="50"
                                                    HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    
                                    <!-- Time Section -->
                                    <StackPanel>
                                        <TextBlock Text="Time" 
                                                   Foreground="#9ca3af" 
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="0,0,0,10"/>
                                        <TimePicker Name="TimePicker"
                                                    Background="#0f1729"
                                                    Foreground="White"
                                                    BorderBrush="#374151"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16,12"
                                                    FontSize="15"
                                                    Height="50"
                                                    HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Upload Button -->
                    <Button Grid.Row="4"
                            Name="UploadButton"
                            Content="Share with Community"
                            Background="#10b981"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="20,15"
                            FontSize="16"
                            FontWeight="Bold"
                            HorizontalAlignment="Stretch"
                            Click="Upload_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
