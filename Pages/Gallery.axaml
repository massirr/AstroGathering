<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:AstroGathering.Pages"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="830"
             x:Class="AstroGathering.Pages.GalleryPage">
    
    <!-- Photo Gallery Page -->
    <Grid Background="#1a1235">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Gallery Content -->
        </Grid.RowDefinitions>
        
        <!-- HEADER SECTION -->
        <StackPanel Grid.Row="0" Margin="40,30,40,20" Spacing="20">
            
            <!-- Page Title and Photo Count -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title and Description -->
                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Text="Photo Gallery" 
                              FontSize="32" 
                              FontWeight="Bold" 
                              Foreground="White"/>
                    <TextBlock Text="Explore celestial photography from our community" 
                              FontSize="16" 
                              Foreground="#b8a7d9"/>
                </StackPanel>
                
                <!-- Photo Count -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center" 
                           Spacing="10">
                    <TextBlock x:Name="PhotoCountText" 
                              Text="0 photos found" 
                              FontSize="14" 
                              Foreground="#8a7ca8"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            
        </StackPanel>
        
        <!-- GALLERY CONTENT -->
        <ScrollViewer Grid.Row="1" 
                     Margin="40,0,40,40"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Auto">
            
            <Grid>
                <!-- Loading Indicator -->
                <StackPanel x:Name="LoadingPanel" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Spacing="20"
                           IsVisible="True">
                    <TextBlock Text="Loading astronomical images..." 
                              FontSize="16" 
                              Foreground="#b8a7d9" 
                              HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- No Photos Message -->
                <StackPanel x:Name="NoPhotosPanel" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Spacing="20"
                           IsVisible="False">
                    <TextBlock Text="No photos found" 
                              FontSize="18" 
                              Foreground="#b8a7d9" 
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Check back later for new astronomical images!" 
                              FontSize="14" 
                              Foreground="#8a7ca8" 
                              HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Photo Grid -->
                <ItemsControl x:Name="PhotoGrid" IsVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="pages:GalleryPhoto">
                        <!-- Photo Card -->
                        <Border Background="#2d1b69" 
                               CornerRadius="12" 
                               Margin="10" 
                               Padding="0"
                               Width="320" 
                               Height="400"
                               BorderBrush="#4c3a8a" 
                               BorderThickness="1">
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>  <!-- Image -->
                                    <RowDefinition Height="*"/>    <!-- Content -->
                                </Grid.RowDefinitions>
                                
                                <!-- Image Section -->
                                <Border Grid.Row="0" 
                                       CornerRadius="12,12,0,0" 
                                       ClipToBounds="True"
                                       Background="#1a1235">
                                    <Image Source="{Binding LoadedImage}"
                                           Stretch="UniformToFill" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                </Border>
                                
                                <!-- Content Section -->
                                <StackPanel Grid.Row="1" 
                                           Margin="15" 
                                           Spacing="10">
                                    
                                    <!-- Title -->
                                    <TextBlock Text="{Binding CleanName}" 
                                              FontSize="14" 
                                              FontWeight="SemiBold" 
                                              Foreground="White" 
                                              TextWrapping="Wrap" 
                                              MaxLines="2"
                                              TextTrimming="CharacterEllipsis"/>
                                    
                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" 
                                              FontSize="12" 
                                              Foreground="#b8a7d9" 
                                              TextWrapping="Wrap" 
                                              MaxLines="3"
                                              TextTrimming="CharacterEllipsis"/>
                                    
                                    <!-- Profile & Date Info -->
                                    <StackPanel Spacing="8">
                                        <!-- Profile Info -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Source:" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source}" 
                                                      FontSize="11" 
                                                      Foreground="#8a7ca8" 
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Date Info -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Date:" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FormattedDate}" 
                                                      FontSize="11" 
                                                      Foreground="#8a7ca8" 
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Location Info (for user uploads) -->
                                        <StackPanel Orientation="Horizontal" 
                                                   Spacing="8"
                                                   IsVisible="{Binding HasLocation}">
                                            <TextBlock Text="📍" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Location}" 
                                                      FontSize="11" 
                                                      Foreground="#8a7ca8" 
                                                      VerticalAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      MaxLines="1"
                                                      TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <!-- Tags and Likes -->
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Tags -->
                                        <StackPanel Grid.Column="0" 
                                                   Orientation="Horizontal" 
                                                   Spacing="5">
                                            <Border Background="#b8a7d9" 
                                                   CornerRadius="3" 
                                                   Padding="4,2">
                                                <TextBlock Text="{Binding TypeTag}" 
                                                          FontSize="10" 
                                                          Foreground="#4c3a8a"/>
                                            </Border>
                                        </StackPanel>
                                        
                                        <!-- Likes -->
                                        <StackPanel Grid.Column="1" 
                                                   Orientation="Horizontal" 
                                                   Spacing="4">
                                            <TextBlock Text="Likes:" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LikeCount}" 
                                                      FontSize="11" 
                                                      Foreground="#8a7ca8" 
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            </Grid>
        </ScrollViewer>
        
    </Grid>
</UserControl>
