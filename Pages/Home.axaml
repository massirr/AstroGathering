<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="AstroGathering.Pages.HomePage">
    
    <!-- Main Home Page Content (without navigation) -->
    <Grid Background="#1a1235" Margin="40,30,40,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>  <!-- Left: Calendar -->
            <ColumnDefinition Width="30"/> <!-- Spacer -->
            <ColumnDefinition Width="2*"/>  <!-- Right: Highlights (even wider) -->
        </Grid.ColumnDefinitions>
            
            <!-- LEFT COLUMN: Astronomical Calendar -->
            <Border Grid.Column="0" 
                    Background="#2d1b69" 
                    CornerRadius="20" 
                    Padding="30">
                <StackPanel Spacing="25">
                    
                    <!-- Calendar Header -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center" 
                               Spacing="15">
                        <TextBlock Text="Astronomical Calendar" 
                                  FontSize="20" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Month Navigation -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center" 
                               Spacing="20">
                        <Button x:Name="PrevMonthButton" 
                               Background="#4c3a8a" 
                               Foreground="White" 
                               CornerRadius="5" 
                               Width="35" 
                               Height="35">
                            <TextBlock Text="&lt;" HorizontalAlignment="Center"/>
                        </Button>
                        
                        <TextBlock x:Name="CurrentMonthText" 
                                  Text="August 2025" 
                                  FontSize="18" 
                                  FontWeight="Medium" 
                                  Foreground="White" 
                                  VerticalAlignment="Center" 
                                  MinWidth="120" 
                                  TextAlignment="Center"/>
                        
                        <Button x:Name="NextMonthButton" 
                               Background="#4c3a8a" 
                               Foreground="White" 
                               CornerRadius="5" 
                               Width="35" 
                               Height="35">
                            <TextBlock Text="&gt;" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- Calendar Grid -->
                    <Border Background="#1a1235" 
                           CornerRadius="10" 
                           Padding="20">
                        <Grid x:Name="CalendarGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>  <!-- Day headers -->
                                <RowDefinition Height="*"/>   <!-- Week 1 -->
                                <RowDefinition Height="*"/>   <!-- Week 2 -->
                                <RowDefinition Height="*"/>   <!-- Week 3 -->
                                <RowDefinition Height="*"/>   <!-- Week 4 -->
                                <RowDefinition Height="*"/>   <!-- Week 5 -->
                                <RowDefinition Height="*"/>   <!-- Week 6 -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Day Headers -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Su" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Mo" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Tu" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="We" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Th" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="Fr" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Sa" Foreground="#8a7ca8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                            
                            <!-- Calendar days will be populated programmatically -->
                        </Grid>
                    </Border>
                    
                    <!-- Calendar Note -->
                    <TextBlock Text="Future: Hover over days to see astronomical events" 
                              FontSize="12" 
                              Foreground="#8a7ca8" 
                              HorizontalAlignment="Center" 
                              TextAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- RIGHT COLUMN: Today's Highlights & Summary -->
            <StackPanel Grid.Column="2" Spacing="25">
                
                <!-- Today's Highlights -->
                <Border Background="#2d1b69" 
                        CornerRadius="20" 
                        Padding="30">
                    <StackPanel Spacing="20">
                        
                        <!-- Highlights Header -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Spacing="15">
                            <TextBlock Text="Today's Highlights" 
                                      FontSize="22" 
                                      FontWeight="Bold" 
                                      Foreground="White" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Today's Events -->
                        <Border Background="#1a1235" 
                               CornerRadius="10" 
                               Padding="25" 
                               MinHeight="150">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                         MaxHeight="300"
                                         HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TodaysEventsText" 
                                          Text="No events today. Perfect for general stargazing!" 
                                          Foreground="#b8a7d9" 
                                          FontSize="14" 
                                          LineHeight="20"
                                          TextWrapping="Wrap" 
                                          HorizontalAlignment="Left" 
                                          VerticalAlignment="Top" 
                                          TextAlignment="Left"
                                          MaxWidth="400"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- This Month Summary -->
                <Border Background="#2d1b69" 
                        CornerRadius="20" 
                        Padding="30">
                    <StackPanel Spacing="20">
                        
                        <!-- Summary Header -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Spacing="15">
                            <TextBlock Text="This Month Summary" 
                                      FontSize="22" 
                                      FontWeight="Bold" 
                                      Foreground="White" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Summary Stats -->
                        <Border Background="#1a1235" 
                               CornerRadius="10" 
                               Padding="25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          Text="Total Events" 
                                          Foreground="#b8a7d9" 
                                          FontSize="16"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                          x:Name="TotalEventsText" 
                                          Text="0" 
                                          Foreground="White" 
                                          FontSize="16" 
                                          FontWeight="Bold"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          Text="Meteor Showers" 
                                          Foreground="#b8a7d9" 
                                          FontSize="16" 
                                          Margin="0,12,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                          x:Name="MeteorShowersText" 
                                          Text="0" 
                                          Foreground="White" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,12,0,0"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          Text="Moon Phases" 
                                          Foreground="#b8a7d9" 
                                          FontSize="16" 
                                          Margin="0,12,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                          x:Name="MoonPhasesText" 
                                          Text="0" 
                                          Foreground="White" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,12,0,0"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                          Text="Planetary Events" 
                                          Foreground="#b8a7d9" 
                                          FontSize="16" 
                                          Margin="0,12,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" 
                                          x:Name="PlanetaryEventsText" 
                                          Text="0" 
                                          Foreground="White" 
                                          FontSize="16" 
                                          FontWeight="Bold" 
                                          Margin="0,12,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                
            </StackPanel>
    </Grid>
</UserControl>
